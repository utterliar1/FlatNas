# ----------------------
# Frontend
# ----------------------
frontend/dist/
frontend/tmp/

# Vite 加载 vite.config.ts 时产生的临时 bundle（进程被中断时会残留）
frontend/vite.config.ts.timestamp-*.mjs

# 构建前对 server/public 的整体挪移暂存目录（避免批量删除保护，仅本地保留）
server/.public_prev/

# ----------------------
# 构建产物：由 CI（.github/workflows/release.yml）或本地构建生成，不入库
#   · server/public、debian/server/public —— Vite 产物，后端从这里读静态文件
#   · 发布用的 flatnas-<arch>.zip 由 Release 流水线打包，不再提交到仓库
# ----------------------
server/public/
debian/server/public/

# ----------------------
# Project Data & Config
# ----------------------
# Runtime state and secrets must stay local and must not be committed.
server/data/*
server/doc/*
server/music/*
!server/data/.gitkeep
!server/doc/.gitkeep
!server/music/.gitkeep

# Debian 离线包运行期目录：整目录忽略（secret.key / data.json / icon-cache / 用户上传）
# 注意 secret.key 绝不能入库：deploy.sh 会把这里的内容复制进安装目录，
# 一旦所有实例共用同一密钥，任何人都能伪造任意用户（含管理员）的 JWT。
debian/server/data/*
!debian/server/data/.gitkeep
debian/server/doc/*
!debian/server/doc/.gitkeep
debian/server/music/*
!debian/server/music/.gitkeep
debian/server/PC/*
!debian/server/PC/.gitkeep
debian/server/APP/*
!debian/server/APP/.gitkeep

.fnsync_temp_dir/
win/
.cursor/

